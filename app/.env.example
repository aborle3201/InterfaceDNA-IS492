# Copy to app/.env and fill in. Never commit app/.env.
GROQ_API_KEY=gsk_your_actual_api_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Optional: pin the date the rules are evaluated on (YYYY-MM-DD), e.g. to show
# the graduate Reading Day cutoff (Fall 2026 Reading Day is 2026-12-10).
# INTERFACEDNA_TODAY=2026-12-11

# Optional: database location (default app/data/interfacedna.db, rebuilt with `python db.py`).
# INTERFACEDNA_DB=data/interfacedna.db
